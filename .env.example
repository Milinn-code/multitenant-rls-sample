# すべてローカル開発用の固定値（docker-compose.yml と対応）。未設定ならこの値が既定になる。
# 管理用（ロール作成・マイグレーション実行・テストの検証用）
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:54329/rls_sample
# アプリが接続するロール（所有者ではない / BYPASSRLS なし）
APP_DATABASE_URL=postgres://app_user:app_user_local@localhost:54329/rls_sample
# 運営者用ロール（テナント横断の SECURITY DEFINER 関数だけを実行できる）
OPS_DATABASE_URL=postgres://ops_user:ops_user_local@localhost:54329/rls_sample
